{
  "name": "phlowers-stellar-app",
  "version": "1.7.2",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "build:service-worker": "tsc -p tsconfig.worker.json && sed -i 's/export //g' public/service-worker.js",
    "build": "npm run build:service-worker && ng build --configuration=production",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
    "prettier-check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts,html}\"",
    "lint-check": "eslint .",
    "lint-check-blocked": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:update": "playwright test e2e/update-flow.spec.ts",
    "e2e:prepare": "npm run build",
    "prime-debug:screenshots": "node scripts/capture-prime-debug-screenshots.mjs",
    "set-up-mechaphlowers": "uv run ./scripts/set_up_mechaphlowers_v2.py",
    "set-up-mechaphlowers:local-cdn": "uv run ./scripts/set_up_mechaphlowers_v2.py --local-cdn-dir",
    "set-up-mechaphlowers:local-mechaphlowers": "uv run ./scripts/set_up_mechaphlowers_v2.py --local-mechaphlowers",
    "set-up-mechaphlowers:engine-only": "uv run ./scripts/set_up_mechaphlowers_v2.py --engine-only",
    "set-env-variables": "uv run ./scripts/set-env-variables.py",
    "create-mock-data": "uv run ./scripts/create_mock_data.py",
    "create-assets-list-for-service-worker:fr": "uv run  --no-cache ./scripts/create_assets_list_for_service_worker.py --language fr",
    "create-assets-list-for-service-worker:en": "uv run  --no-cache ./scripts/create_assets_list_for_service_worker.py --language en",
    "cyclonedx": "npx @cyclonedx/cyclonedx-npm --ignore-npm-errors --output-file bom.xml --output-format XML",
    "docs": "cd docs-sphinx && uv run sphinx-build -M clean source build && uv run sphinx-build -M html source build",
    "autodocs": "cd docs-sphinx && uv run sphinx-autobuild --host localhost --port 8000 source build",
    "docs:open": "npm run docs && xdg-open docs-sphinx/build/html/index.html"
  },
  "browser": {
    "child_process": false,
    "crypto": false,
    "fs": false,
    "fs/promises": false,
    "path": false,
    "url": false,
    "vm": false,
    "ws": false,
    "node:crypto": false,
    "node:url": false
  },
  "private": true,
  "engines": {
    "node": "22"
  },
  "config": {
    "mechaphlowers": "0.6.0rc2",
    "thermohl": "1.4.0"
  },
  "dependencies": {
    "@angular-slider/ngx-slider": "21.0.0",
    "@angular/animations": "21.2.18",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.18",
    "@angular/compiler": "21.2.18",
    "@angular/core": "21.2.18",
    "@angular/forms": "21.2.18",
    "@angular/platform-browser": "21.2.18",
    "@angular/platform-browser-dynamic": "21.2.18",
    "@angular/router": "21.2.18",
    "@eslint/js": "9.27.0",
    "@fortawesome/fontawesome-free": "7.3.0",
    "@jsverse/transloco": "8.4.0",
    "@primeng/themes": "21.0.4",
    "@types/plotly.js-dist-min": "2.3.4",
    "@typescript-eslint/parser": "8.59.0",
    "dexie": "4.4.4",
    "javascript-time-ago": "2.6.4",
    "jspdf": "4.2.1",
    "lodash": "4.18.1",
    "marked": "18.0.6",
    "ngx-markdown": "21.3.0",
    "papaparse": "5.5.4",
    "plotly.js-dist-min": "3.7.0",
    "primeicons": "7.0.0",
    "primeng": "21.1.9",
    "pyodide": "0.28.3",
    "rxjs": "7.8.1",
    "tailwindcss-primeui": "0.5.1",
    "tslib": "2.3.0",
    "uuid": "14.0.0",
    "zone.js": "0.16.2"
  },
  "overrides": {
    "marked": "$marked",
    "uuid": "14.0.0",
    "tar": "7.5.21",
    "brace-expansion": "2.0.1",
    "minimatch": "10.0.3",
    "rolldown": "1.0.0",
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.5"
    },
    "picomatch": "4.0.4",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "chokidar": {
      "readdirp": "4.0.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    }
  },
  "devDependencies": {
    "@analogjs/platform": "2.6.3",
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-builders/custom-esbuild": "21.1.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular/build": "21.2.19",
    "@angular/cli": "21.2.19",
    "@angular/compiler-cli": "21.2.18",
    "@cyclonedx/cyclonedx-npm": "6.0.0",
    "@jsverse/transloco-schematics": "^8.4.0",
    "@playwright/test": "1.61.1",
    "@types/lodash": "4.17.24",
    "@types/papaparse": "5.5.2",
    "@types/plotly.js": "2.35.14",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "21.4.0",
    "autoprefixer": "10.5.2",
    "esbuild-node-externals": "1.23.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "4.2.5",
    "jsdom": "26.1.0",
    "postcss": "^8.5.25",
    "prettier": "3.9.4",
    "tailwindcss": "3.4.19",
    "typedoc": "0.28.20",
    "typescript": "5.9",
    "typescript-eslint": "8.63.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.10",
    "vitest-sonar-reporter": "3.0.0"
  }
}
