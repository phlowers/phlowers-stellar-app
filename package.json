{
  "name": "phlowers-stellar-app",
  "version": "1.7.1",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4200",
    "start:fr": "ng serve --port 4200 --configuration=fr",
    "build:service-worker": "tsc -p tsconfig.worker.json && sed -i 's/export //g' public/service-worker.js",
    "build": "npm run build:service-worker && ng build --configuration=production",
    "build:fr": "npm run build:service-worker && ng build --output-mode=static --configuration=production,fr && npm run set-env-variables && npm run create-assets-list-for-service-worker:fr",
    "build:en": "npm run build:service-worker && ng build --output-mode=static --configuration=production,en && npm run set-env-variables && npm run create-assets-list-for-service-worker:en",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
    "prettier-check": "prettier --check \"**/*.{js,mjs,ts,mts,d.ts,html}\"",
    "lint-check": "eslint .",
    "lint-check-blocked": "eslint . --quiet",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:update": "playwright test e2e/update-flow.spec.ts",
    "e2e:prepare": "npm run build:en",
    "set-up-mechaphlowers": "uv run ./scripts/set_up_mechaphlowers_v2.py",
    "set-up-mechaphlowers:local-cdn": "uv run ./scripts/set_up_mechaphlowers_v2.py --local-cdn-dir",
    "set-up-mechaphlowers:local-mechaphlowers": "uv run ./scripts/set_up_mechaphlowers_v2.py --local-mechaphlowers",
    "set-up-mechaphlowers:engine-only": "uv run ./scripts/set_up_mechaphlowers_v2.py --engine-only",
    "set-env-variables": "uv run ./scripts/set-env-variables.py",
    "create-mock-data": "uv run ./scripts/create_mock_data.py",
    "create-assets-list-for-service-worker:fr": "uv run  --no-cache ./scripts/create_assets_list_for_service_worker.py --language fr",
    "create-assets-list-for-service-worker:en": "uv run  --no-cache ./scripts/create_assets_list_for_service_worker.py --language en",
    "extract-i18n": "ng extract-i18n --output-path assets/i18n --format=xlf2",
    "cyclonedx": "npx @cyclonedx/cyclonedx-npm --output-file bom.xml  --output-format XML",
    "docs": "cd docs-sphinx && uv run sphinx-build -M clean source build && uv run sphinx-build -M html source build",
    "autodocs": "cd docs-sphinx && uv run sphinx-autobuild --host localhost --port 8000 source build",
    "docs:open": "npm run docs && xdg-open docs-sphinx/build/html/index.html"
  },
  "browser": {
    "child_process": false,
    "crypto": false,
    "fs": false,
    "fs/promises": false,
    "path": false,
    "url": false,
    "vm": false,
    "ws": false,
    "node:crypto": false,
    "node:url": false
  },
  "private": true,
  "engines": {
    "node": "22"
  },
  "config": {
    "mechaphlowers": "0.6.0rc2",
    "thermohl": "1.4.0"
  },
  "dependencies": {
    "@angular-eslint/eslint-plugin-template": "19.8.1",
    "@angular-slider/ngx-slider": "19.0.0",
    "@angular/animations": "19.2.21",
    "@angular/common": "19.2.21",
    "@angular/compiler": "19.2.21",
    "@angular/core": "19.2.21",
    "@angular/forms": "19.2.21",
    "@angular/platform-browser": "19.2.21",
    "@angular/platform-browser-dynamic": "19.2.21",
    "@angular/router": "19.2.21",
    "@eslint/js": "9.27.0",
    "@fortawesome/fontawesome-free": "7.1.0",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "@primeng/themes": "19.1.4",
    "@types/plotly.js-dist-min": "2.3.4",
    "@typescript-eslint/parser": "8.59.0",
    "chart.js": "4.4.2",
    "dexie": "4.0.11",
    "esbuild-plugin-polyfill-node": "0.3.0",
    "esbuild-plugins-node-modules-polyfill": "1.7.0",
    "font-awesome": "4.7.0",
    "javascript-time-ago": "2.5.11",
    "jspdf": "4.2.1",
    "lodash": "4.18.1",
    "marked": "15.0.0",
    "ngx-markdown": "19.1.1",
    "papaparse": "5.5.3",
    "plotly.js-dist-min": "3.0.1",
    "primeclt": "0.1.5",
    "primeicons": "7.0.0",
    "primeng": "19.1.4",
    "pyodide": "0.28.3",
    "raw-loader": "4.0.2",
    "rxjs": "7.8.1",
    "tailwindcss-primeui": "0.5.1",
    "tslib": "2.3.0",
    "url-browserify": "1.3.0",
    "uuid": "14.0.0",
    "zone.js": "0.15.0"
  },
  "overrides": {
    "marked": "$marked",
    "uuid": "14.0.0",
    "tar": "7.5.13",
    "copy-webpack-plugin": {
      "serialize-javascript": "7.0.5"
    },
    "picomatch": "4.0.4",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    }
  },
  "devDependencies": {
    "@analogjs/platform": "2.4.10",
    "@analogjs/vite-plugin-angular": "2.4.10",
    "@analogjs/vitest-angular": "2.4.10",
    "@angular-builders/custom-esbuild": "19.1.0",
    "@angular-devkit/build-angular": "19.2.24",
    "@angular/build": "19.2.24",
    "@angular/cli": "19.2.24",
    "@angular/compiler-cli": "19.2.21",
    "@angular/localize": "19.2.21",
    "@cyclonedx/cyclonedx-npm": "4.2.1",
    "@playwright/test": "1.59.1",
    "@types/jasmine": "5.1.0",
    "@types/lodash": "4.17.16",
    "@types/papaparse": "5.3.16",
    "@types/plotly.js": "2.35.5",
    "@vitest/coverage-v8": "3.2.4",
    "angular-eslint": "19.8.1",
    "autoprefixer": "10.4.20",
    "esbuild-node-externals": "1.18.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "eslint-plugin-prettier": "4.2.1",
    "jasmine-core": "5.4.0",
    "jsdom": "26.0.0",
    "ng-extract-i18n-merge": "2.15.1",
    "postcss": "8.4.49",
    "prettier": "3.5.3",
    "random-words-commonjs": "2.0.1",
    "tailwindcss": "3.4.17",
    "typedoc": "0.28.16",
    "typescript": "5.6.2",
    "typescript-eslint": "8.59.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.4",
    "vitest-sonar-reporter": "3.0.0"
  }
}
