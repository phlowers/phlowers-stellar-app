{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // "module": "CommonJS",
    "isolatedModules": false,
    "target": "esnext",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom",
      "webworker"
    ],
    "types": [
      "vitest/globals",
      "jest",
      "node",
      "@angular/localize"
    ],
    "paths": {
      "@src/*": [
        "./src/*"
      ],
      "@app/*": [
        "./src/app/*"
      ],
      "@core/*": [
        "./src/app/core/*"
      ],
      "@services/*": [
        "./src/app/core/services/*"
      ],
      "@ui/*": [
        "./src/app/ui/*"
      ],
      "@features/*": [
        "./src/app/features/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ],
      "@infrastructure/*": [
        "./src/app/infrastructure/*"
      ]
    },
  },
  "files": [
    "src/test-setup.ts"
  ],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}